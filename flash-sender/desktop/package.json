{
  "name": "flash-sender-desktop",
  "productName": "Flash Sender by Nora",
  "version": "1.0.0",
  "private": true,
  "description": "Send configured cryptocurrency coins and tokens on EVM networks.",
  "author": {
    "name": "Nora"
  },
  "license": "UNLICENSED",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:dir": "npm run build && electron-builder --dir",
    "package:win": "npm run build && electron-builder --win --x64",
    "package:win:portable": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "ethers": "^6.13.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^2.1.8"
  }
}
