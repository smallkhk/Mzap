# ---------------------------------------------------------------------------
# Flash Sender backend — environment template
#
# Copy to .env and fill in. NEVER commit the real .env.
#
# This file contains NO wallet key material and never should. The backend has
# no code path that accepts, stores or transmits a private key or mnemonic;
# adding one here would do nothing except leak a secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# MySQL / MariaDB connection string.
#   Local docker compose:  mysql://flash:flash@localhost:3306/flashsender
#   cPanel:                mysql://cpuser_flash:PASSWORD@localhost:3306/cpuser_flashsender
#
# If the password contains @ : / ? # or %, URL-encode it (@ becomes %40).
DATABASE_URL="mysql://flash:flash@localhost:3306/flashsender"

# Signing key for admin access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Browser origins allowed to call the admin API (comma-separated).
# Leave as-is when the dashboard is served by this process (ADMIN_DIST_PATH
# below) — same-origin requests need no CORS entry at all.
ADMIN_ORIGINS=http://localhost:5174

# Serve the built admin dashboard from this same process, at the site root.
# This makes the dashboard same-origin with the API: one domain, one TLS
# certificate, no CORS. Recommended for cPanel and other single-app hosts.
# Leave blank to run an API-only backend.
#ADMIN_DIST_PATH=../admin/dist

# Set REQUIRE_HTTPS=true in production. If TLS is terminated by a proxy
# (cPanel/Passenger, nginx, Caddy, a load balancer), also set TRUST_PROXY=true
# so the X-Forwarded-Proto header is honoured and rate limits see real client IPs.
REQUIRE_HTTPS=false
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# SAFETY SWITCH
#
# TESTNET_ONLY=true makes this deployment refuse to store or serve any
# non-testnet network. Keep it true for development so a misconfiguration
# cannot touch real funds. Set it to false only on the deployment you
# intend to use with mainnet.
# ---------------------------------------------------------------------------
TESTNET_ONLY=true
