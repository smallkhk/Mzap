# ---------------------------------------------------------------------------
# Flash Sender backend — environment template
#
# Copy to .env and fill in. NEVER commit the real .env.
#
# This file contains NO wallet key material and never should. The backend has
# no code path that accepts, stores or transmits a private key or mnemonic;
# adding one here would do nothing except leak a secret.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# PostgreSQL connection string.
#   Local docker-compose:  postgresql://flash:flash@localhost:5432/flashsender
#   Managed provider:      add ?sslmode=require
DATABASE_URL=postgresql://flash:flash@localhost:5432/flashsender

# Signing key for admin access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Browser origins allowed to call the admin API (comma-separated).
ADMIN_ORIGINS=http://localhost:5174

# Set REQUIRE_HTTPS=true in production. If TLS is terminated by a proxy
# (nginx, Caddy, a load balancer), also set TRUST_PROXY=true so the
# X-Forwarded-Proto header is honoured.
REQUIRE_HTTPS=false
TRUST_PROXY=false

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

LOG_LEVEL=info

# ---------------------------------------------------------------------------
# SAFETY SWITCH
#
# TESTNET_ONLY=true makes this deployment refuse to store or serve any
# non-testnet network. Keep it true for development so a misconfiguration
# cannot touch real funds. Set it to false only on the deployment you
# intend to use with mainnet.
# ---------------------------------------------------------------------------
TESTNET_ONLY=true
