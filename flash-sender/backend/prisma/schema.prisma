// Flash Sender by Nora — backend datastore.
//
// The backend is the source of truth for *configuration* (networks + assets)
// and an append-mostly ledger of transaction records reported by desktop
// clients. It deliberately stores no key material of any kind: there is no
// column anywhere in this schema for a private key, mnemonic or wallet
// password, and the API rejects any payload carrying one.
//
// Targets MySQL 8 / MariaDB 10.4+, which is what shared hosting provides.
// Values with no native column type there (URL lists, audit snapshots) are
// stored as TEXT and encoded via src/lib/columns.ts.

generator client {
  provider = "prisma-client-js"

  // Query engines to ship with the generated client.
  //
  // "native" covers the machine that runs `prisma generate`. The explicit
  // targets cover shared hosting (cPanel/CloudLinux), which commonly runs an
  // older OpenSSL than the generating machine — without them the client
  // generates fine and then fails at startup with
  // "could not locate the Query Engine for runtime debian-openssl-1.0.x".
  binaryTargets = ["native", "debian-openssl-1.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum AdminRole {
  ADMIN
  VIEWER
}

/// A human operator of the admin dashboard.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         AdminRole @default(VIEWER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  refreshTokens RefreshToken[]

  @@map("admin_users")
}

/// Hashed refresh tokens. Rotated on every use; a replayed token revokes the
/// whole family (reuse detection).
model RefreshToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  familyId   String
  userId     String
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// A desktop installation. Identified by an API key presented as `X-API-Key`.
/// Only the SHA-256 of the key is stored; the plaintext is shown once at
/// creation time and never again.
model ApiClient {
  id         String    @id @default(cuid())
  name       String
  keyHash    String    @unique
  keyPrefix  String
  isActive   Boolean   @default(true)
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())

  /// Grants this one key holder a self-service web panel scoped to itself:
  /// it can add tokens to the shared catalog and manage its own spending
  /// limits, but has no route to see or create any other key. Off by
  /// default — a key issued for the desktop app is not automatically a
  /// portal login.
  portalEnabled Boolean @default(false)

  /// This client's own deposit address for buying tokens, derived once from
  /// the buy-wallet seed at a deterministic index — never a freshly generated,
  /// independently stored key. `buyWalletIndex` is what actually determines
  /// the address (assigned once, immutable); `buyWalletAddress` is a cache of
  /// what that index derives to, kept only so it can be displayed and queried
  /// without unlocking the seed on every read.
  buyWalletIndex   Int?    @unique
  buyWalletAddress String? @unique

  transactions   TransactionRecord[]
  spendingLimits SpendingLimit[]
  privateAssets  Asset[]

  @@map("api_clients")
}

/// Per-client, per-asset spending caps for custodial sending.
///
/// With one shared wallet, any client holding a valid API key can move funds.
/// These caps are the mechanism that bounds what a leaked key can cost: a
/// client with no limit row for an asset cannot send that asset at all, so
/// access is opt-in per asset rather than blanket.
model SpendingLimit {
  id       String    @id @default(cuid())
  clientId String
  client   ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Asset.assetId this limit applies to.
  assetId String

  /// Maximum for a single transaction, in base units (decimal string).
  maxPerTxRaw  String
  /// Maximum total per rolling UTC day, in base units (decimal string).
  maxPerDayRaw String

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, assetId])
  @@index([assetId])
  @@map("spending_limits")
}

// ---------------------------------------------------------------------------
// Configuration — what the desktop app is allowed to send
// ---------------------------------------------------------------------------

/// A blockchain the application can talk to. `chainId` is authoritative: the
/// desktop client re-checks it against the RPC endpoint's reported chain id
/// before signing anything, so a misconfigured network fails closed.
model Network {
  id            String   @id @default(cuid())
  key           String   @unique // stable slug, e.g. "bsc", "bsc-testnet"
  name          String // "BNB Smart Chain"
  chainId       Int      @unique
  /// Newline-delimited list, tried in order; each must be https:// or wss://.
  /// Read and written through encodeUrlList/decodeUrlList, never directly.
  rpcUrlsRaw    String   @db.Text
  explorerUrl   String   @db.VarChar(500) // base explorer URL, e.g. https://bscscan.com
  nativeSymbol  String // "BNB"
  nativeName    String // "BNB"
  nativeDecimals Int     @default(18)
  isTestnet     Boolean  @default(true)
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assets Asset[]

  @@map("networks")
}

/// A sendable coin or token. Exactly one of (isNative) / (contractAddress)
/// is meaningful: native assets carry no contract, token assets must carry a
/// checksummed EVM address.
model Asset {
  id              String   @id @default(cuid())
  /// Stable public identifier used by the desktop app, e.g. "usdt-bsc".
  assetId         String   @unique
  name            String // "Tether USD"
  symbol          String // "USDT"
  networkId       String
  network         Network  @relation(fields: [networkId], references: [id], onDelete: Restrict)
  /// Null for native assets. Stored EIP-55 checksummed. 42 chars; the length
  /// is pinned because this column sits in a composite unique index.
  contractAddress String?  @db.VarChar(42)
  decimals        Int
  isNative        Boolean  @default(false)
  /// Optional per-asset explorer override; falls back to the network's.
  explorerUrl     String?  @db.VarChar(500)
  logoUrl         String?  @db.VarChar(500)
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  /// Null = part of the shared, admin-curated catalog every client sees.
  /// Set = a private addition, visible and usable only by the one client
  /// that added it — never surfaced to anyone else, including other
  /// clients and the admin dashboard's own Assets list.
  clientId String?
  client   ApiClient? @relation(fields: [clientId], references: [id], onDelete: Cascade)

  /// Always non-null; "global" for the shared catalog, or the owning
  /// client's id for a private asset. Exists only so the uniqueness check
  /// below actually works: MySQL treats every NULL as distinct from every
  /// other NULL, so a plain (networkId, contractAddress) unique index
  /// would let any number of NULL-clientId rows through and defeat
  /// per-client scoping — every private asset's clientId is copied here at
  /// write time specifically to give NULL a real, comparable value.
  ownerScope String @default("global")

  @@unique([networkId, contractAddress, ownerScope])
  @@index([enabled])
  @@index([clientId])
  @@map("assets")
}

/// Single-row table holding the configuration version. Bumped by any mutation
/// to `networks` or `assets` so clients can cheaply detect staleness via
/// GET /api/config/version.
model ConfigVersion {
  id        Int      @id @default(1)
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("config_version")
}

/// Single-row table holding admin-editable settings for the buy/swap feature
/// — markup and where its profit goes. A DB row rather than an env var
/// deliberately: it changes from the dashboard, without a redeploy.
///
/// `buyMarkupBps` only ever affects a *customer's* own buy (portal), where it
/// is the whole point of the feature. It has no bearing on the admin
/// dashboard's own buy tool, which spends the shared wallet's own funds —
/// there is no one to charge a markup to.
model AppSetting {
  id Int @id @default(1)

  /// Markup in basis points (1/100 of a percent). 250 = 2.5%. A customer buy
  /// is credited raw_output * (10000 - buyMarkupBps) / 10000; the remainder
  /// is sent to profitAddress from the same swap.
  buyMarkupBps Int @default(0)

  /// Where markup profit is sent. Null means markup is effectively disabled
  /// even if buyMarkupBps is nonzero — there is deliberately no fallback
  /// destination, so a swap can never skim funds to nowhere.
  profitAddress String?

  /// Next derivation index to hand out for a client's buy wallet. Read and
  /// incremented inside one transaction when a client is first assigned one,
  /// so two concurrent "generate wallet" calls can never receive the same
  /// index.
  nextBuyWalletIndex Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ---------------------------------------------------------------------------
// Transaction ledger
// ---------------------------------------------------------------------------

enum TxStatus {
  PREPARING
  AWAITING_CONFIRMATION
  SIGNING
  BROADCASTING
  PENDING
  CONFIRMED
  FAILED
  REJECTED
}

/// A record of a transaction the desktop app actually broadcast.
///
/// `txHash` is whatever the RPC node returned from eth_sendRawTransaction —
/// the server never generates, derives or backfills it. A record may exist
/// with a null hash only while it is in a pre-broadcast state.
model TransactionRecord {
  id       String @id @default(cuid())
  /// Client-supplied idempotency key, unique per client. Prevents a retried
  /// POST from creating a duplicate ledger row.
  clientRef String   @db.VarChar(36)

  txHash   String?  @db.VarChar(66)
  chainId  Int
  status   TxStatus @default(PREPARING)

  assetId         String // Asset.assetId at time of send
  symbol          String
  decimals        Int
  isNative        Boolean
  contractAddress String?

  fromAddress String
  toAddress   String
  /// Integer base-unit amount, as a decimal string (uint256 exceeds bigint).
  amountRaw   String
  /// Human-readable amount, for display only. Never used for arithmetic.
  amountDisplay String

  blockNumber       Int?
  gasUsed           String?
  effectiveGasPrice String?
  /// gasUsed * effectiveGasPrice, in native base units, as a decimal string.
  feeRaw            String?
  nonce             Int?
  confirmations     Int     @default(0)

  errorCode    String?
  /// Validation allows up to 1024 chars, past VARCHAR(191).
  errorMessage String?  @db.Text

  submittedAt DateTime  @default(now())
  broadcastAt DateTime?
  confirmedAt DateTime?
  updatedAt   DateTime  @updatedAt

  clientId String?
  client   ApiClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@unique([clientId, clientRef])
  @@unique([txHash, chainId])
  @@index([fromAddress])
  @@index([status])
  @@index([submittedAt])
  @@map("transaction_records")
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

/// Append-only record of every configuration change and auth event.
model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // "admin" | "client" | "system"
  actorId    String?
  actorLabel String?
  action     String // "asset.create", "auth.login.failed", ...
  entity     String?
  entityId   String?
  /// JSON snapshots, encoded via encodeJson/decodeJson.
  before     String?  @db.Text
  after      String?  @db.Text
  ip         String?  @db.VarChar(45) // fits a full IPv6 literal
  userAgent  String?  @db.VarChar(512)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
}
